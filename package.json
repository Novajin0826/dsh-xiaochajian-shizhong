{
  "name": "skill-management",
  "description": "Adds a Skills section to the composer + menu with enable/disable filtering, plus a manager panel for searching, toggling, deleting and batch-managing installed skills. 在输入框 + 菜单顶部增加技能分组，附管理页搜索、启用/停用、删除与批量管理。",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "composer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Novajin0826/dsh-xiaochajian-shizhong.git"
  },
  "homepage": "https://github.com/Novajin0826/dsh-xiaochajian-shizhong",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "assets/icon-180.png",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  }
}
